  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\STM32MX\NO1homework\build\Debug && C:\mingw64\bin\cmake.exe --regenerate-during-build -SD:\STM32MX\NO1homework -BD:\STM32MX\NO1homework\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# D:/STM32MX/NO1homework/CMakeLists.txt
# =============================================================================

# =============================================================================
